# Paste this into Streamlit Cloud -> your app -> Settings -> Secrets (never commit real values).
# Needed so "Forgot password" can email reset codes.

[smtp]
host = "smtp.gmail.com"
port = 587                        # 587 = STARTTLS (default), 465 = SSL
user = "youraddress@gmail.com"
# Gmail: turn on 2-step verification, then Google Account -> Security -> App passwords.
# Paste the 16-character app password (spaces are fine). NOT your normal Gmail password.
password = "abcd efgh ijkl mnop"
# from_addr = "Grade App <youraddress@gmail.com>"   # optional display name / sender
# starttls = false                                  # only for local test servers

# For testing only: show the code on screen instead of emailing it.
# dev_show_code = true
