# Paste ONE of these options into Streamlit Cloud -> your app -> Settings -> Secrets.
# Never commit real values. Needed so sign-up / password-reset codes can be emailed.

# ---- Option 1 (recommended): your own Gmail, through the Google Apps Script in apps_script/Code.gs
[apps_script]
url = "https://script.google.com/macros/s/XXXXXXXX/exec"   # the Web app URL from Deploy
token = "the same long random value you set as the SECRET script property"

# ---- Option 2: SMTP with a Gmail App Password (only used if [apps_script] is absent)
# [smtp]
# host = "smtp.gmail.com"
# port = 587
# user = "youraddress@gmail.com"
# password = "abcd efgh ijkl mnop"

# For testing only: show the code on screen instead of emailing it.
# dev_show_code = true
