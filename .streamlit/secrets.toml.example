# Paste into Streamlit Cloud -> your app -> Settings -> Secrets. Never commit real values.
# IMPORTANT: lines that are not inside a [section] (like ANTHROPIC_API_KEY) must come FIRST,
# above the [apps_script] / [smtp] headers, or TOML will treat them as part of that section.

# ---- AI study assistant (optional). Get a key at https://console.anthropic.com
# Usage is billed to that account. Without a key the Assistant tab just shows setup instructions.
ANTHROPIC_API_KEY = "sk-ant-..."
# anthropic_model = "claude-sonnet-5-5"   # optional; default is claude-opus-5-5 (cheaper: sonnet-5-5 or haiku-5-5)

# For testing only: show sign-up/reset codes on screen instead of emailing them.
# (Ignored whenever [apps_script] or [smtp] below is present.)
# dev_show_code = true

# ---- Email for sign-up / reset codes, Option 1 (recommended): your own Gmail via apps_script/Code.gs
[apps_script]
url = "https://script.google.com/macros/s/XXXXXXXX/exec"   # the Web app URL from Deploy
token = "the same long random value you set as the SECRET script property"

# ---- Option 2: SMTP with a Gmail App Password (only used if [apps_script] is absent)
# [smtp]
# host = "smtp.gmail.com"
# port = 587
# user = "youraddress@gmail.com"
# password = "abcd efgh ijkl mnop"
